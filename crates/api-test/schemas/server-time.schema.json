{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Polymarket 服务器时间",
  "description": "GET /time 响应",
  "type": "object",
  "required": ["timestamp"],
  "properties": {
    "timestamp": {
      "type": "integer",
      "minimum": 1000000000,
      "description": "Unix 时间戳（秒）"
    }
  }
}
