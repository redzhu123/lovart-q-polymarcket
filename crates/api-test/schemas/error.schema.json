{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Polymarket API 错误响应",
  "description": "API 错误响应通用格式",
  "type": "object",
  "required": ["error"],
  "properties": {
    "error": {
      "type": "string",
      "minLength": 1,
      "description": "错误消息"
    },
    "code": {
      "type": "string",
      "description": "错误码"
    },
    "status": {
      "type": "integer",
      "description": "HTTP 状态码"
    },
    "message": {
      "type": "string",
      "description": "详细错误描述"
    }
  }
}
